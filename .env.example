# Discord Bot
DISCORD_TOKEN=

# Discord OAuth2 for the dashboard (scopes: identify guilds)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/dashboard/auth/callback

# PostgreSQL / Supabase
DATABASE_URL=

# Groq (advisory threat analysis)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Dashboard service-to-service authentication (keep server-side)
DASHBOARD_API_KEY=

# Browser dashboard session (generate a random secret >= 32 chars)
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL_SECONDS=3600
DASHBOARD_FRONTEND_URL=http://localhost:3000

# Application
APP_ENV=development
LOG_LEVEL=INFO
